# Copy to .env and fill in. .env is gitignored — never commit real values.

# PostgreSQL. The database named here is created on startup if missing.
DB_HOST=localhost
DB_PORT=5432
DB_USER=
DB_PASS=
DB_NAME=esp32

# Port the API and the dashboard are served on.
PORT=3055

# Dashboard write access. Reads are public; every mutating request must send
# this as the X-Admin-Token header. The three firmware routes (sync, report,
# watering) are exempt. Leave empty to disable write protection entirely.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(37).toString('base64url').slice(0,50))"
ADMIN_TOKEN=
